<UserControl x:Class="DeviceMocker.Views.EmulatorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DeviceMocker.Models"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Top Status & Controller Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,10" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Status info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status dot -->
                    <Border x:Name="statusDot" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    
                    <!-- Status Text -->
                    <TextBlock Text="Host Status: " FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ListenerStatus}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="|" FontSize="13" Foreground="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <!-- Drawer Status Badge -->
                    <TextBlock Text="Drawer: " FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,16,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1AEF4444"/>
                                <Setter Property="BorderBrush" Value="#80EF4444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DrawerState}" Value="Closed">
                                        <Setter Property="Background" Value="#1A10B981"/>
                                        <Setter Property="BorderBrush" Value="#8010B981"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="9.5" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="OPENED"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DrawerState}" Value="Closed">
                                            <Setter Property="Text" Value="CLOSED"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="|" FontSize="13" Foreground="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <!-- Session Info -->
                    <TextBlock Text="{Binding SessionSummary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                </StackPanel>

                <!-- Right Column: Host Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start Host" Style="{StaticResource BaseButtonStyle}" Command="{Binding StartHostCommand}" Margin="0,0,6,0" Padding="14,6" FontSize="12"/>
                    <Button Content="Stop Host" Style="{StaticResource DangerButtonStyle}" Command="{Binding StopHostCommand}" Margin="0,0,6,0" Padding="14,6" FontSize="12"/>
                    <Button Content="Close Drawer" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding MarkDrawerClosedCommand}" Margin="0,0,6,0" Padding="12,6" FontSize="11.5"/>
                    <Button Content="Clear Logs" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearLogsCommand}" Padding="12,6" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: 3-Column Workspace Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Compact Configuration Panel -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,4,0"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <StackPanel>
                    <!-- Unified Emulator Config Card -->
                    <Border Style="{StaticResource CardStyle}" Padding="16,14">
                        <StackPanel>
                            <!-- Profile Selection Header -->
                            <TextBlock Text="EMULATOR PROFILE" Style="{StaticResource SectionHeaderStyle}"/>

                            <TextBlock Text="Active Profile Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>

                            <TextBlock Text="Select Stored Profile" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                                      Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,8"/>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Button Content="Load Profile" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadProfileCommand}" Margin="0,0,4,4" Padding="10,6" FontSize="11"/>
                                <Button Content="Save Profile" Style="{StaticResource BaseButtonStyle}" Command="{Binding SaveProfileCommand}" Margin="4,0,0,4" Padding="10,6" FontSize="11"/>
                                <Button Content="Create New" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CreateProfileCommand}" Margin="0,4,4,0" Padding="10,6" FontSize="11"/>
                                <Button Content="Refresh List" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshProfilesCommand}" Margin="4,4,0,0" Padding="10,6" FontSize="11"/>
                            </UniformGrid>

                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                <CheckBox Content="Auto-start host with this profile"
                                          IsChecked="{Binding AutoStartWithSelectedProfile}"
                                          Style="{StaticResource ModernCheckBoxStyle}"/>
                            </Border>

                            <!-- Hardware Configuration details -->
                            <TextBlock Text="HARDWARE CONFIGURATION" Style="{StaticResource SectionHeaderStyle}"/>

                            <!-- Grid selectors for compactness -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Device Type" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding DeviceFamilyOptions}" SelectedItem="{Binding SelectedDeviceFamily}" Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Protocol" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding SelectedProtocol}" Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Drawer Link" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding DrawerLinkModeOptions}" SelectedItem="{Binding SelectedDrawerLinkMode}" Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Transport" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding SelectedTransport}" Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Paper Width" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding PaperWidthOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedPaperWidth}" Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Generate paper preview"
                                      IsChecked="{Binding RenderReceiptPreview}"
                                      Style="{StaticResource ModernCheckBoxStyle}" Margin="0,2,0,12"/>

                            <!-- Conditional Transport Fields -->
                            <!-- Serial configuration -->
                            <StackPanel Visibility="{Binding IsSerialTransport, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="COM Port" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableSerialPorts}" SelectedItem="{Binding SelectedSerialPort}" Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Baud Rate" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"
                                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Scan COM Ports" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshPortsCommand}" Padding="10,6" FontSize="11" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- TCP configuration -->
                            <StackPanel Visibility="{Binding IsTcpTransport, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.7*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Binding IP Address" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding TcpHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TCP Port" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"
                                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- HTTP configuration (disabled placeholder) -->
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10" Visibility="{Binding IsHttpTransport, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <TextBlock Text="HTTP listener is deferred in this release."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </Border>

                            <!-- Message placeholder -->
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Column 2: Stacked Logs Console (Middle Column) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Log: Raw Byte Traffic Console -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Raw Byte Traffic Console" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CopyRawLogsCommand}" Padding="10,4" FontSize="10.5"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding RawLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Message}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                                </Grid>
                                                <TextBlock Text="{Binding DataHex}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource AccentLightBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Bottom Log: Parsed Event Console -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Parsed Stream Event Monitor" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CopyParsedLogsCommand}" Padding="10,4" FontSize="10.5"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding ParsedLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Message}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" FontFamily="Consolas"/>
                                                </StackPanel>
                                                
                                                <!-- Category Badge -->
                                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" CornerRadius="4" Padding="5,2" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1A7C3AED"/>
                                                            <Setter Property="BorderBrush" Value="#807C3AED"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                                    <Setter Property="Background" Value="#1AEF4444"/>
                                                                    <Setter Property="BorderBrush" Value="#80EF4444"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                                    <Setter Property="Background" Value="#1AF59E0B"/>
                                                                    <Setter Property="BorderBrush" Value="#80F59E0B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Drawer">
                                                                    <Setter Property="Background" Value="#1A10B981"/>
                                                                    <Setter Property="BorderBrush" Value="#8010B981"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Info">
                                                                    <Setter Property="Background" Value="#1A4F8CFF"/>
                                                                    <Setter Property="BorderBrush" Value="#804F8CFF"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Session">
                                                                    <Setter Property="Background" Value="#1AA78BFA"/>
                                                                    <Setter Property="BorderBrush" Value="#80A78BFA"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    
                                                    <TextBlock Text="{Binding Kind}" FontSize="9" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Drawer">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Info">
                                                                        <Setter Property="Foreground" Value="#4F8CFF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Session">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Column 4: Receipt Tape Preview (Right Column) -->
            <Border Grid.Column="4" Background="#FAF9F5" CornerRadius="6" BorderBrush="#EBEAE5" BorderThickness="1,3,1,3" Padding="16,20" Margin="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.15"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PRINTER TAPE PREVIEW" FontSize="9" FontWeight="Bold" Foreground="#8C8B88" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Border DockPanel.Dock="Top" BorderBrush="#D1CFC9" BorderThickness="0,0,0,1" Margin="0,0,0,12" Height="1" SnapsToDevicePixels="True"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding ReceiptBlocks}">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type models:ReceiptTextBlock}">
                                    <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11.5" Foreground="#222222"/>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type models:ReceiptImageBlock}">
                                    <Image Source="{Binding Bitmap}" Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Stretch="Fill" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="Fant"/>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
