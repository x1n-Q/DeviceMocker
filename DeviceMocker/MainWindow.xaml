<Window x:Class="DeviceMocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeviceMocker.ViewModels"
        xmlns:views="clr-namespace:DeviceMocker.Views"
        xmlns:scanner="clr-namespace:DeviceMocker.Devices.Scanner"
        xmlns:vkb="clr-namespace:DeviceMocker.Devices.VirtualKeyboard"
        xmlns:pos="clr-namespace:DeviceMocker.Devices.PosPanel"
        xmlns:serial="clr-namespace:DeviceMocker.Devices.SerialDevice"
        xmlns:scale="clr-namespace:DeviceMocker.Devices.Scale"
        xmlns:rfid="clr-namespace:DeviceMocker.Devices.RfidReader"
        xmlns:mag="clr-namespace:DeviceMocker.Devices.MagstripeReader"
        xmlns:seq="clr-namespace:DeviceMocker.Devices.SequenceBuilder"
        xmlns:drawer="clr-namespace:DeviceMocker.Devices.CashDrawer"
        Title="DeviceMocker - Hardware Development Toolkit"
        Icon="Assets/DeviceMocker.ico"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><views:DevicesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmulatorsViewModel}"><views:EmulatorsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><views:ProfilesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><views:LogsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type scanner:ScannerViewModel}"><scanner:ScannerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vkb:VirtualKeyboardViewModel}"><vkb:VirtualKeyboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type pos:PosPanelViewModel}"><pos:PosPanelView/></DataTemplate>
        <DataTemplate DataType="{x:Type serial:SerialDeviceViewModel}"><serial:SerialDeviceView/></DataTemplate>
        <DataTemplate DataType="{x:Type scale:ScaleViewModel}"><scale:ScaleView/></DataTemplate>
        <DataTemplate DataType="{x:Type rfid:RfidReaderViewModel}"><rfid:RfidReaderView/></DataTemplate>
        <DataTemplate DataType="{x:Type mag:MagstripeReaderViewModel}"><mag:MagstripeReaderView/></DataTemplate>
        <DataTemplate DataType="{x:Type seq:SequenceBuilderViewModel}"><seq:SequenceBuilderView/></DataTemplate>
        <DataTemplate DataType="{x:Type drawer:CashDrawerViewModel}"><drawer:CashDrawerView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Title Block -->
                <Grid DockPanel.Dock="Top" Margin="16,18,16,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Width="34"
                           Height="34"
                           Source="Assets/DeviceMocker-icon-512.png"
                           Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DeviceMocker" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Hardware and POS Toolkit" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Version Block -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="v1.1.1" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Run Text="by " Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Run Text="x1n-Q" Foreground="{DynamicResource AccentLightBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <!-- Nav Menu List -->
                <StackPanel Margin="8,0">
                    <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,8"/>
                    
                    <!-- Dashboard -->
                    <Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,10" Margin="4,2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⛃" Width="20" FontSize="13" FontFamily="Segoe UI Emoji" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageTitle}" Value="Dashboard">
                                        <Setter Property="Background" Value="{DynamicResource ActiveNavBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Devices -->
                    <Button Content="Devices" Command="{Binding NavigateCommand}" CommandParameter="Devices">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,10" Margin="4,2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⌨" Width="20" FontSize="13" FontFamily="Segoe UI Emoji" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageTitle}" Value="Devices">
                                        <Setter Property="Background" Value="{DynamicResource ActiveNavBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Emulators -->
                    <Button Content="Emulators" Command="{Binding NavigateCommand}" CommandParameter="Emulators">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,10" Margin="4,2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🖥" Width="20" FontSize="13" FontFamily="Segoe UI Emoji" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageTitle}" Value="Emulators">
                                        <Setter Property="Background" Value="{DynamicResource ActiveNavBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Hardware Test App -->
                    <Button Content="Hardware Test" Command="{Binding LaunchHardwareTestCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,10" Margin="4,2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🧪" Width="20" FontSize="13" FontFamily="Segoe UI Emoji" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Profiles -->
                    <Button Content="Profiles" Command="{Binding NavigateCommand}" CommandParameter="Profiles">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,10" Margin="4,2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📂" Width="20" FontSize="13" FontFamily="Segoe UI Emoji" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageTitle}" Value="Profiles">
                                        <Setter Property="Background" Value="{DynamicResource ActiveNavBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Logs -->
                    <Button Content="Logs" Command="{Binding NavigateCommand}" CommandParameter="Logs">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,10" Margin="4,2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📋" Width="20" FontSize="13" FontFamily="Segoe UI Emoji" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageTitle}" Value="Logs">
                                        <Setter Property="Background" Value="{DynamicResource ActiveNavBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Settings -->
                    <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,10" Margin="4,2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚙" Width="20" FontSize="13" FontFamily="Segoe UI Emoji" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageTitle}" Value="Settings">
                                        <Setter Property="Background" Value="{DynamicResource ActiveNavBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Content Area -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryBrush}" Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Back" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GoBackCommand}" Padding="12,6" Margin="0,0,16,0" FontSize="12"/>
                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource PrimaryBrush}">
                <ContentControl Content="{Binding CurrentPage}" Margin="24,20"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
